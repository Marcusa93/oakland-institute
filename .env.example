# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.

# Entorno lógico: desarrollo | pruebas | produccion
NEXT_PUBLIC_ENTORNO=desarrollo

# Supabase (Project Settings → API). La clave publicable puede ir al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta: SOLO servidor (invitar cuentas, tareas programadas, webhooks).
# No lleva el prefijo NEXT_PUBLIC_ y no debe importarse desde componentes cliente.
SUPABASE_SECRET_KEY=

# URL pública del sitio (enlaces de invitación y recuperación).
NEXT_PUBLIC_SITIO_URL=http://localhost:3000

# Secreto que protege las rutas de tareas programadas (/api/tareas/*).
CRON_SECRET=

# Asistente: "ninguno" responde solo con fragmentos de la documentación aprobada.
# El proveedor de IA está pendiente de definición.
ASISTENTE_PROVEEDOR=ninguno

# Solo para scripts/usuarios-demo.mjs en desarrollo o pruebas.
DEMO_CLAVE=cambiar-esta-clave-demo
